  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #7" >
    <att name="SystemName" value="Loan Management" />
    <att name="Description" value="The Loan Management system facilitates the loan application and approval process. Loan Officers utilize the system to check applicant eligibility, credit history, and assess home values, ultimately sanctioning loans. Home Buyers interact with the system to process mortgage and loan applications. The system serves as a central platform for managing the loan lifecycle, from initial application to final approval." />
    <att name="PrimaryDomain" value="Mortgage Lending" />
    <att name="SystemKind" value="Management" />
    <att name="HasInclude" value="No" />
    <att name="HasExtend" value="No" />
