  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #39" >
    <att name="SystemName" value="UAV Mission Planning" />
    <att name="Description" value="The UAV Mission Planning system enables an Operator to plan, execute, and monitor missions for Unmanned Aerial Vehicles (UAVs). The Operator interacts with the system to create missions, allocate UAVs, and evaluate mission outcomes. The system utilizes a Camera for image capture during missions, a Server for command processing and mission initiation, and GPS for coordinate management. The system supports creating markers and removing coordinates as part of mission definition, and sending commands to the UAV during mission execution." />
    <att name="PrimaryDomain" value="UAV Mission Management" />
    <att name="SystemKind" value="Planning" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="No" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Operator | Camera | Server | GPS" />
    <att name="UseCaseNames" value="Evaluate Mission | Create Marker | Remove Coordinate | Capture Image | Allocate Uav | Feed Command | Assign Search Area | Send Command | Start Mission | Monitor Mission | Create Mission" />
    <att name="RelationshipTypes" value="association | include" />
    <att name="DomainList" value="UAV Mission Management | Geospatial Data Processing | Command and Control Systems | Image Acquisition | Mission Planning" />
    <att name="PrimaryActorCount" value="1.0" />
    <att name="SecondaryActorCount" value="3.0" />
    <att name="UseCaseCount" value="11.0" />
    <att name="RelationshipCount" value="14.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #40" >
    <att name="SystemName" value="Satellite System" />
    <att name="Description" value="The Satellite System manages the operation of a satellite, enabling payload status retrieval, command transmission (both real-time and stored), infrared sensor pointing, and orbital maneuvers. The system interacts with Payload Operators for status and sensor control, Flight Controllers for orbital adjustments, and Environmental Test Engineers for power generation testing. The Solar Simulation Chamber is used to test electricity generation." />
    <att name="PrimaryDomain" value="Satellite Command and Control" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="No" />
    <att name="HasGeneralization" value="Yes" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Payload Operator | Flight Controller | Environmental Test Engineer | Solar Simulation Chamber" />
    <att name="UseCaseNames" value="Get Payload Status | Send Real Time Command | Send Stored Command | Point Infrared Sensor | Send Command | Execute Hohmann Transfer | Generate Electricity" />
    <att name="RelationshipTypes" value="association | generalization | include" />
    <att name="DomainList" value="Satellite Command and Control | Payload Management | Orbital Mechanics | Power Systems Testing | Infrared Sensor Operation" />
    <att name="PrimaryActorCount" value="3.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="7.0" />
    <att name="RelationshipCount" value="10.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #41" >
    <att name="SystemName" value="Appointment Booking " />
    <att name="Description" value="The Appointment Booking system facilitates the scheduling of appointments between a User and a Service Provider. Users can initiate calls, while Service Providers manage technical issues and appointment slots. The Payment Gateway handles payment-related functionalities. Scheduling an appointment automatically triggers a confirmation. Showing a payment method necessitates receiving payment. Displaying available slots can be extended to show alternative options when no slots are available." />
    <att name="PrimaryDomain" value="Appointment Scheduling" />
    <att name="SystemKind" value="Booking" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="User | Service Provider | Payment Gateway" />
    <att name="UseCaseNames" value="Resolve Technical Issue | Send Confirmation | Schedule Appointment | Receive Payment | Show Payment Method | Show Alternative Option | Display Available Slot | Make Call" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Appointment Scheduling | Service Management | Payment Processing | Customer Support | Communication" />
    <att name="PrimaryActorCount" value="2.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="8.0" />
    <att name="RelationshipCount" value="9.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #42" >
    <att name="SystemName" value="Cab Booking Application" />
    <att name="Description" value="The Cab Booking Application facilitates users in booking cabs. Users interact with the system to choose locations, book cabs, view available cabs, confirm bookings, access their accounts, and delete bookings. The Backend actor supports the system by confirming bookings and providing available cab information." />
    <att name="PrimaryDomain" value="Ride-Hailing Services" />
    <att name="SystemKind" value="Application" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="User | Backend" />
    <att name="UseCaseNames" value="Choose Location | Delete Booking | Show Driver Information | Confirm Booking | Show Payment Method | Book Cab | Show Available Cabs | Access Account" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Ride-Hailing Services | Transportation Logistics | Mobile Applications | Payment Processing | User Account Management" />
    <att name="PrimaryActorCount" value="1.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="8.0" />
    <att name="RelationshipCount" value="11.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #43" >
    <att name="SystemName" value="Sentinel EMS" />
    <att name="Description" value="The Sentinel EMS system manages product definition, customer management, and environment configuration. Privilege Managers and Customer Service representatives manage customer data. Developers generate product keys, trial products, branded resources, and runtime installers. Product Managers define product features. The system includes functionality for defining both trial and full products, with trial products incorporating runtime installer generation. Environment management is included in branded resource generation and product key generation." />
    <att name="PrimaryDomain" value="Product Lifecycle Management" />
    <att name="SystemKind" value="EMS" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="Yes" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Privilege Manager | Customer Service | Developer | Product Manager" />
    <att name="UseCaseNames" value="Generate Product Key | Define Trial Product | Define Full Product | Manage Customer | Manage Environment | Generate Branded Rus | Generate Runtime Installer | Generate Trial Product | Define Product | Define Feature" />
    <att name="RelationshipTypes" value="association | extend | generalization | include" />
    <att name="DomainList" value="Product Lifecycle Management | Entitlement Management | Software Distribution | Customer Relationship Management | Environment Configuration" />
    <att name="PrimaryActorCount" value="4.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="10.0" />
    <att name="RelationshipCount" value="13.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #44" >
    <att name="SystemName" value="Airport" />
    <att name="Description" value="The Airport system manages passenger check-in, baggage handling, and boarding processes. Airport Staff interact with the system to issue boarding passes and validate check-ins. Passengers interact with the system to validate their check-in (individually or in groups) and drop off baggage. The system includes processes for assigning gates and handling baggage, which are incorporated into other use cases." />
    <att name="PrimaryDomain" value="Airline Operations" />
    <att name="SystemKind" value="Airport" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="No" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Airport Staff | Passenger" />
    <att name="UseCaseNames" value="Assign Gate | Handle Baggage | Enter Security Screening | Issue Boarding Pass | Validate Counter Checkin | Drop Baggage | Validate Individual Checkin | Validate Group Checkin" />
    <att name="RelationshipTypes" value="association | include" />
    <att name="DomainList" value="Airline Operations | Airport Security | Baggage Handling | Passenger Check-in | Gate Management" />
    <att name="PrimaryActorCount" value="2.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="8.0" />
    <att name="RelationshipCount" value="8.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #45" >
    <att name="SystemName" value="Vehicle " />
    <att name="Description" value="The Vehicle system manages core vehicle functions and passenger interactions. The Driver operates the vehicle, while the Vehicle Occupant interacts with accessories and enters/exits the vehicle. The system provides functionalities like driving, braking, controlling entertainment and climate, and managing vehicle access. The system interacts with the Driver to perform driving actions, and with the Vehicle Occupant to control accessories and manage entry/exit." />
    <att name="PrimaryDomain" value="Automotive Engineering" />
    <att name="SystemKind" value="Vehicle" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="Yes" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Vehicle Occupant | Driver" />
    <att name="UseCaseNames" value="Perform Anti Lock Braking | Drive Vehicle | Control Entertainment System | Control Vehicle Accessory | Control Climate System | Exit Vehicle | Open Door | Enter Vehicle" />
    <att name="RelationshipTypes" value="association | extend | generalization | include" />
    <att name="DomainList" value="Automotive Engineering | Vehicle Control Systems | Passenger Comfort Systems | Vehicle Safety Systems | Vehicle Access Control" />
    <att name="PrimaryActorCount" value="2.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="8.0" />
    <att name="RelationshipCount" value="9.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #46" >
    <att name="SystemName" value="Design Support System" />
    <att name="Description" value="The Design Support System facilitates the design and finalization of products, primarily furniture, involving clients, engineers, and administration. Clients initiate requirements and finalize products, while engineers focus on structural and heating design approvals. Administration verifies client requirements. The system supports issue reporting that can extend the product finalization process." />
    <att name="PrimaryDomain" value="Furniture Design" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Client | Administration | Engineer" />
    <att name="UseCaseNames" value="Report Issue | Finalize Product | Verify Client Requirement | Validate Furniture Design | Approve Heating Design | Approve Structural Design" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Furniture Design | Structural Engineering | Heating, Ventilation, and Air Conditioning (HVAC) | Requirements Management | Product Lifecycle Management" />
    <att name="PrimaryActorCount" value="3.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="6.0" />
    <att name="RelationshipCount" value="10.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #47" >
    <att name="SystemName" value="Administration Application" />
    <att name="Description" value="The Administration Application provides functionalities for managing system operations, user access, and logging. The Website Administrator and Helpdesk interact with the system to perform tasks such as managing users, sessions, logs, and access control policies. System backups are performed as part of access control policy management. The Helpdesk primarily focuses on log and session management, while the Website Administrator handles a broader range of administrative tasks including user management." />
    <att name="PrimaryDomain" value="System Administration" />
    <att name="SystemKind" value="Application" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="No" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Website Administrator | Helpdesk" />
    <att name="UseCaseNames" value="Perform System Backup | Manage Access Control Policy | Manage Logs | Manage Session | Manage User" />
    <att name="RelationshipTypes" value="association | include" />
    <att name="DomainList" value="System Administration | Access Control Management | User Management | Log Management | System Backup and Recovery" />
    <att name="PrimaryActorCount" value="1.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="5.0" />
    <att name="RelationshipCount" value="7.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #48" >
    <att name="SystemName" value="Online Shopping System" />
    <att name="Description" value="The Online Shopping System facilitates product management, user registration, and the purchase of products. Administrators manage the product catalog, while users can browse, add items to a cart, purchase products, report issues, and access their accounts. The Backend Database System supports product information and user registration." />
    <att name="PrimaryDomain" value="E-commerce" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="No" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Administrator | User | Backend Database System" />
    <att name="UseCaseNames" value="Recommend New Product | Update Product Detail | Delete Product | Add Product | Report Technical Issue | Register User | Buy Product | Add To Cart | View Product | Access Account" />
    <att name="RelationshipTypes" value="association | extend" />
    <att name="DomainList" value="E-commerce | Product Management | User Account Management | Database Management | Customer Support" />
    <att name="PrimaryActorCount" value="2.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="10.0" />
    <att name="RelationshipCount" value="12.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #49" >
    <att name="SystemName" value="Library Management System" />
    <att name="Description" value="A system for managing library books, members, and borrowing processes." />
    <att name="PrimaryDomain" value="Education" />
