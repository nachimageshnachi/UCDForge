  <instance id="UCD_CBR_Cycle_ProjectCase #38" >
    <att name="SystemName" value="Real Time System Controller" />
    <att name="Description" value="The Real Time System Controller manages system maintenance, setup, and shutdown procedures, as well as data acquisition, computation, and information delivery. The Maintenance Crew initiates maintenance procedures, while the Supervisor oversees system setup and shutdown. The System User receives information from the system. Sensors provide input for computation, and actuators execute computational results. The system supports both scheduled and on-demand maintenance." />
    <att name="PrimaryDomain" value="Real-time Control Systems" />
    <att name="SystemKind" value="Controller" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
