  <instance id="UCD_CBR_Cycle_ProjectCase #35" >
    <att name="SystemName" value="Security System" />
    <att name="Description" value="The Security System monitors for intrusions and allows an Operator to activate and deactivate the system. An Intruder triggers sensors, which the system monitors. The system's primary function is to detect and respond to security breaches, with the Operator having control over system activation and deactivation, and monitoring system status." />
