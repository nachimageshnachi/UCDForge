  <instance id="UCD_CBR_Cycle_ProjectCase #19" >
    <att name="SystemName" value="Surveillance System " />
    <att name="Description" value="The Surveillance System monitors a safe zone for sheep and bears, utilizing input from a Mission Operator, Ground Station, GPS Constellation, and Weather data. The system allows for mission planning and preparation, surveying of the safe zone, and protection of sheep. The Ground Station and GPS Constellation provide data for system monitoring. Bears attempt to enter the safe zone, while sheep require protection. Mission preparation includes parameterization and planning phases." />
    <att name="PrimaryDomain" value="Wildlife Monitoring" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Mission Operator | Sheep | Bear | Ground Station | GPS Constellation | Weather" />
    <att name="UseCaseNames" value="Enter Safe Zone | Protect Sheep | Survey Safe Zone | Monitor System | Parameterize Mission | Plan Mission | Prepare Mission" />
    <att name="RelationshipTypes" value="association | extend | include" />
