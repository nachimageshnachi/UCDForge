    <att name="ActorNames" value="Maintenance Crew | Supervisor | System User | Sensor | Actuator" />
    <att name="UseCaseNames" value="Apply Upon Request Maintenance | Apply Scheduled Maintenance | Apply Maintenance Procedure | Run Shutdown Procdure | Run Setup Proedure | Acquire Input | Perform Computation | Store Result | Inform User" />
    <att name="RelationshipTypes" value="association | extend | generalization | include" />
    <att name="DomainList" value="Real-time Control Systems | System Maintenance Management | Data Acquisition and Processing | Supervisory Control | User Information Systems" />
