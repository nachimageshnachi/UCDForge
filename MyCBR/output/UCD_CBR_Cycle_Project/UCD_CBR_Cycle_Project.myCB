  <instance id="UCD_CBR_Cycle_ProjectCase #37" >
    <att name="SystemName" value="Aircraft Design Review System" />
    <att name="Description" value="The Aircraft Design Review System facilitates the review and approval of aircraft designs. Design Engineers submit designs and register components. Systems Engineers review these designs. Project Managers approve modifications. The system generates review reports, optionally extending the submission process when changes are required, and incorporates design component registration into the submission process." />
