  <instance id="UCD_CBR_Cycle_ProjectCase #18" >
    <att name="SystemName" value="Coursework Management" />
    <att name="Description" value="The Coursework Management system facilitates the administration, delivery, submission, and assessment of coursework. Administrators configure courses, Lecturers retrieve coursework for grading, and Students submit coursework and retrieve their marks. Submitters publish marks, potentially triggered by a student's request to retrieve their mark." />
