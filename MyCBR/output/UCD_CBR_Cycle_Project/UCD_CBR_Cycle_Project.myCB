    <att name="UseCaseNames" value="Edit Booking | Cancel Booking | Manage Reservation | Check Availability | Assist Passenger | Resolve Technical Issue | Manage User Account | Manage Flight Schedule | Book Ticket | Search Flight" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Airline Reservation | Travel Management | Customer Service | Flight Operations | User Account Management" />
    <att name="PrimaryActorCount" value="3.0" />
