  <instance id="UCD_CBR_Cycle_ProjectCase #30" >
    <att name="SystemName" value="Ticket Booking System" />
    <att name="Description" value="The Ticket Booking System facilitates the booking of tours and airline tickets through various stakeholders. Customers can book airline tickets and make payments. Travel agents can also book airline tickets and deliver airline tickets. The tourist company is involved in booking tours, and the airline company participates in the airline ticket booking process. Customers may also pay agent fees." />
