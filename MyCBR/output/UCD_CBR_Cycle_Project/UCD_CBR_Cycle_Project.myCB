  <instance id="UCD_CBR_Cycle_ProjectCase #0" >
    <att name="SystemName" value="Missile System" />
    <att name="Description" value="The Missile System is operated by a Launch Station to engage targets and launch missiles. The system includes procedures for testing and handling failed launch scenarios. The Launch Station initiates target engagement, missile launches, and manages failed launch procedures, which may extend the launch process with testing." />
    <att name="PrimaryDomain" value="Missile Defense" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Launch Station" />
    <att name="UseCaseNames" value="Engage Target | Trigger Test | Launch Missile | Execute Failed Launch Procedure" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Missile Defense | Weapon Systems | Launch Operations | System Testing | Failure Management" />
    <att name="PrimaryActorCount" value="0.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="4.0" />
    <att name="RelationshipCount" value="5.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #1" >
    <att name="SystemName" value="Monitoring System" />
    <att name="Description" value="The Monitoring System enables Operators, Advanced Operators, Intruders, and Supervisors to interact with environmental monitoring and system control functions. Operators perform autonomous monitoring, while Advanced Operators can set up tracking and perform manual monitoring. Intruders can monitor the environment, and Supervisors handle camera faults. The system includes initialization and termination procedures as part of environmental monitoring." />
    <att name="PrimaryDomain" value="Security Monitoring" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="Yes" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Operator | Advanced Operator | Intruder | Supervisor" />
    <att name="UseCaseNames" value="Setup Track | Initialize System | Terminate System | Perform Autonomous Monitoring | Perform Manual Monitoring | Monitor Environment | Handle Camera Fault" />
    <att name="RelationshipTypes" value="association | extend | generalization | include" />
    <att name="DomainList" value="Security Monitoring | System Administration | Environmental Monitoring | Fault Management | Operator Interface" />
    <att name="PrimaryActorCount" value="4.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="7.0" />
    <att name="RelationshipCount" value="10.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #2" >
    <att name="SystemName" value="Airport Management System" />
    <att name="Description" value="The Airport Management System facilitates the coordination of air traffic control, ground operations, and airport safety. The ATC manages control zones and clearances, while also being involved in conflict alerting and prevention, and mission planning. The Ground Operations Team and Airport Safety Team primarily participate in conflict alerting and mission planning respectively. The system extends conflict alerting with conflict prevention when a conflict occurs." />
    <att name="PrimaryDomain" value="Air Traffic Control" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="No" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Ground Operations Team | Airport Safety Team | ATC" />
    <att name="UseCaseNames" value="Manage Control Zone | Manage Clearance | Alert During Conflict | Prevent Conflict | Plan Mission" />
    <att name="RelationshipTypes" value="association | extend" />
    <att name="DomainList" value="Air Traffic Control | Airport Operations | Conflict Management | Mission Planning | Safety and Security" />
    <att name="PrimaryActorCount" value="0.0" />
    <att name="SecondaryActorCount" value="3.0" />
    <att name="UseCaseCount" value="5.0" />
    <att name="RelationshipCount" value="9.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #3" >
    <att name="SystemName" value="Exam Mobile Application " />
    <att name="Description" value="The Exam Mobile Application facilitates exam result management, candidate registration, and transcript verification. Students access their accounts and results, while Data Entry Personnel manage registration and session termination. Qualification Managers authorize results and generate transcripts, and Data Managers verify results. The system supports result updates, reporting, and transcript issuance." />
    <att name="PrimaryDomain" value="Exam Result Management" />
    <att name="SystemKind" value="Application" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Data Entry Personnel | Qualification Manager | Data Manager | Student" />
    <att name="UseCaseNames" value="Publish Result | Verify Transcript | Generate Report | Edit Result | Verify Result | View Registration Data | View Result | Terminate Session | Access Account | Update Information | Enter Result | Register Candidate | Generate Transcript | Recieve Transcript | Authorize Result" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Exam Result Management | Candidate Registration | Transcript Verification | User Account Management | Reporting and Analytics" />
    <att name="PrimaryActorCount" value="4.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="15.0" />
    <att name="RelationshipCount" value="17.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #4" >
    <att name="SystemName" value="Fire Alarm System" />
    <att name="Description" value="The Fire Alarm System is designed to detect fires, alert users and authorities, and facilitate system maintenance and shutdown. It interacts with Technicians for initialization and shutdown, Maintenance Operators for fault handling and maintenance, Installation Personnel for system setup, Civilians who are alerted in case of false alarms or actual fires, Fire Department who are informed of fire events, and Sensors which detect fire events. The system also handles system faults and displays a standby state when no fire is detected." />
    <att name="PrimaryDomain" value="Fire Safety" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="Yes" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Technician | Maintenance Operator | Installation Personnel | Civillian | Fire Department | Sensor" />
    <att name="UseCaseNames" value="Handle System Fault | Handle False Alarm | Display Standby | Warn Environment | Perform Maintenance | Alert User | Inform Authority | Detect Fire | Shutdown System | Initialize System" />
    <att name="RelationshipTypes" value="association | extend | generalization | include" />
    <att name="DomainList" value="Fire Safety | Alarm Systems | Emergency Response | System Maintenance | Sensor Integration" />
    <att name="PrimaryActorCount" value="5.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="10.0" />
    <att name="RelationshipCount" value="18.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #5" >
    <att name="SystemName" value="Energy Distribution Management System" />
    <att name="Description" value="The Energy Distribution Management System facilitates the operation and monitoring of power distribution. The Grid Operator interacts with the system to record energy usage and authenticate themselves. The Control Center System is involved in selecting power sources, validating billing, and monitoring power flow. Use cases include generating reports, allocating power, checking transformer loads, activating backup lines, and selecting distribution areas. Authentication is required before selecting a power source, and billing validation includes report generation. Monitoring power flow can be extended by activating a backup line when the main power is unavailable. Transformer load checks are included in power allocation, and power flow monitoring includes transformer load checks." />
    <att name="PrimaryDomain" value="Energy Distribution" />
    <att name="SystemKind" value="System" />
    <att name="HasInclude" value="Yes" />
    <att name="HasExtend" value="Yes" />
    <att name="HasGeneralization" value="No" />
    <att name="CaseOrigin" value="Sql" />
    <att name="ActorNames" value="Grid Operator | Control Center System" />
    <att name="UseCaseNames" value="Generate Energy Report | Validate Energy Billing | Record Energy Usage | Allocate Power Supply | Check Transformer Load | Activate Backup Line | Monitor Power Flow | Select Distribution Area | Select Power Source | Authenticate Operator" />
    <att name="RelationshipTypes" value="association | extend | include" />
    <att name="DomainList" value="Energy Distribution | Power Grid Management | Billing and Reporting | System Authentication | Power Supply Allocation" />
    <att name="PrimaryActorCount" value="1.0" />
    <att name="SecondaryActorCount" value="1.0" />
    <att name="UseCaseCount" value="10.0" />
    <att name="RelationshipCount" value="11.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #6" >
    <att name="SystemName" value="Boarding System" />
    <att name="Description" value="The Boarding System manages the process of passenger boarding, involving interactions between Passengers and Ticket Clerks. Passengers handover luggage and receive tickets, while Ticket Clerks handle luggage processing, which includes assigning seats and weighing luggage. The system facilitates the efficient and organized boarding of passengers." />
    <att name="PrimaryDomain" value="Airline Boarding" />
    <att name="SystemKind" value="System" />
