    <att name="UseCaseNames" value="Provide Maintenance | Alert Refrigerant Leakage | Control Chiller Sequencing | Monitor Chilled Water Temperature | Provide Cooling Service" />
    <att name="RelationshipTypes" value="association | extend | generalization | include" />
