  <instance id="UCD_CBR_Cycle_ProjectCase #10" >
    <att name="SystemName" value="Lab  Testing System" />
    <att name="Description" value="The Lab Testing System facilitates the process of patient assessment, test prescription, test performance, and result delivery. Medical Officers assess patients, prescribe medication and tests. Patients fill out forms and undergo testing. Lab Technicians perform tests and provide results. The system supports the interaction between these stakeholders to manage the lab testing workflow." />
