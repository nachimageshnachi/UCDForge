  <instance id="UCD_CBR_Cycle_ProjectCase #27" >
    <att name="SystemName" value="School Management System" />
    <att name="Description" value="The School Management System facilitates interactions between Administrators, Students, and Teachers to manage school-related information, enrollment, examinations, attendance, and reporting. Administrators add and edit information, prepare report cards, and oversee the system. Students fill admission forms and write exams. Teachers prepare and evaluate exams, and mark attendance." />
