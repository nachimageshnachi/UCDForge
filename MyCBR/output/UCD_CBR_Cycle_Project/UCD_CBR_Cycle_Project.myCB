  <instance id="UCD_CBR_Cycle_ProjectCase #20" >
    <att name="SystemName" value="Parking System" />
    <att name="Description" value="The Parking System manages parking fees and provides receipts. The Parking Manager adjusts parking rates, while Drivers pay parking bills. The system supports hourly and daily rate adjustments, which are generalizations of a broader 'Adjust Rate' function. The Parking Manager can also print receipts." />
