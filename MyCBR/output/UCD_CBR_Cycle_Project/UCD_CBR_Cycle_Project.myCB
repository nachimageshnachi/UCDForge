  <instance id="UCD_CBR_Cycle_ProjectCase #12" >
    <att name="SystemName" value="Clinic Management" />
    <att name="Description" value="The Clinic Management system facilitates interactions between Doctors, Nurses, and Patients to manage patient information, appointments, and medical records. Doctors can view patient histories and give prescriptions. Nurses can print reports. Patients can schedule appointments and enter their own information. The system also records visit information, which is included as part of the appointment scheduling process." />
