  <instance id="UCD_CBR_Cycle_ProjectCase #25" >
    <att name="SystemName" value="Order_Management_System" />
    <att name="Description" value="The Order Management System facilitates the ordering, checking, and segregation of parts. The Purchasing Manager initiates orders, checks permissions, and orders parts. The Warehouse Manager segregates orders, views orders, checks parts, and registers parts. The system extends the 'Order Part' use case with a 'Check Part' function when parts are unavailable." />
