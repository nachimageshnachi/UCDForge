    <att name="ActorNames" value="Loan Officer | Home Buyer" />
    <att name="UseCaseNames" value="Sanction Loan | Check Eligibility | Check Credit History | Assess Home Value | Process Mortgage Application | Process Loan Application" />
    <att name="RelationshipTypes" value="association" />
    <att name="DomainList" value="Mortgage Lending | Loan Origination | Credit Risk Assessment | Financial Services | Home Finance" />
    <att name="PrimaryActorCount" value="2.0" />
    <att name="SecondaryActorCount" value="0.0" />
    <att name="UseCaseCount" value="6.0" />
    <att name="RelationshipCount" value="6.0" />
  </instance>
  <instance id="UCD_CBR_Cycle_ProjectCase #8" >
    <att name="SystemName" value="Flight Reservation System" />
    <att name="Description" value="The Flight Reservation System facilitates booking, managing, and modifying flight reservations. Customers can search for and book tickets. Agents assist passengers and manage reservations. Administrators handle user accounts, flight schedules, and technical issues. The system includes functionality for checking flight availability, editing bookings, and cancelling reservations, with the latter optionally triggering reservation management." />
    <att name="PrimaryDomain" value="Airline Reservation" />
    <att name="SystemKind" value="System" />
