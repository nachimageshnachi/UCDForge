  <instance id="UCD_CBR_Cycle_ProjectCase #33" >
    <att name="SystemName" value="Cellular Telephone" />
    <att name="Description" value="The Cellular Telephone system enables users to make and end phone calls, place conference calls, monitor signal strength, and utilize a scheduler. The system interacts with users directly for call management and with the cellular network for signal monitoring and scheduler functionality. The cellular network provides the underlying infrastructure for these services." />
