    <att name="UseCaseNames" value="Assign Seat | Give Ticket | Handover Luggage | Weigh Luggage | Handle Luggage" />
    <att name="RelationshipTypes" value="association | include" />
    <att name="DomainList" value="Airline Boarding | Luggage Handling | Passenger Services | Ticket Management | Travel Logistics" />
